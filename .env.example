# Lemon Squeezy hosted checkout (frontend, public values — safe to expose).
# Checkout URL is built as:
#   https://<VITE_LEMON_STORE>.lemonsqueezy.com/checkout/buy/<variant>
# where <variant> is VITE_LEMON_PRO_VARIANT_ID or VITE_LEMON_ENTERPRISE_VARIANT_ID.
VITE_LEMON_STORE=
VITE_LEMON_PRO_VARIANT_ID=
VITE_LEMON_ENTERPRISE_VARIANT_ID=

# NOTE: VITE_CLERK_PUBLISHABLE_KEY was removed — auth is Supabase, not Clerk.
# See src/lib/supabase.ts. Do not reintroduce a Clerk key here.
